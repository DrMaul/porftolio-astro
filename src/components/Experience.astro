---
import PythonIcon from '../icons/Python.astro'
import DjangoIcon from '../icons/Django.astro'
import JWTIcon from '../icons/JWT.astro'
import DockerIcon from '../icons/Docker.astro'
import JavascriptIcon from '../icons/Javascript.astro'
import HTMLIcon from '../icons/HtmlIcon.astro'
import CSSIcon from '../icons/CSS.astro'
import FlaskIcon from '../icons/Flask.astro'
import MySQLIcon from '../icons/MySQL.astro'
import RedisIcon from '../icons/Redis.astro'

const EXPERIENCE = [
    {
        date: 'Noviembre 2024 - Actualidad',
        company: 'Summant Technologies',
        role: 'Desarrollador Fullstack Junior',
        description: 'Desarrollo Fullstack sobre dos líneas de trabajo en paralelo: el producto de RRHH Meta4 y un proyecto a medida para cliente externo.',
        highlights: [
            'Meta4 (software de gestión de RRHH): modelado de datos y arquitectura de bases de datos, diseño de objetos, métodos y comunicación entre ellos. Desarrollo de módulos y herramientas dentro del framework (backend). Portal web de autoservicio para empleados desarrollado con HTML, CSS y JavaScript, exponiendo módulos desde Meta4 y conectando vía JSP con su librería propia.',
            'Proyecto a medida (fuera del framework): Automatización de mensajería de WhatsApp integrada con IA: webhook para recepcionar mensajes de usuarios y workers que procesan, integran la IA y envían la respuesta. Para eso se desarrolla un Backend con Flask + Python y Frontend con Django para la gestión del bot por parte del cliente. Modelado de base de datos MySQL e implementación de una API REST con seguridad, autenticación, JWT, gestión de usuarios y mailing. Seguridad de webhooks con firmas HMAC en los headers. Deploy con Docker, administrando entornos de desarrollo (local) y producción (servidor Ubuntu).',
        ],
        stack: ['Python', 'Flask', 'Django', 'MySQL', 'Redis', 'JWT', 'Docker', 'JavaScript', 'HTML', 'CSS', 'Meta4'],
    },
]

const STACK_ICONS = {
    Python: PythonIcon,
    Django: DjangoIcon,
    JWT: JWTIcon,
    Docker: DockerIcon,
    JavaScript: JavascriptIcon,
    HTML: HTMLIcon,
    CSS: CSSIcon,
    Flask: FlaskIcon,
    MySQL: MySQLIcon,
    Redis: RedisIcon,
}
---
<ol class="relative border-s border-gray-200 ml-4 w-full max-w-3xl">
    {EXPERIENCE.map((exp) => (
        <li class="mb-10 ms-4">
            <div class="absolute w-3 h-3 bg-yellow-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900"></div>
            <time class="mb-1 text-sm font-normal leading-none text-sky-200/90">{exp.date}</time>
            <h3 class="text-lg font-semibold text-yellow-200 mt-4">{exp.role} · {exp.company}</h3>
            <p class="my-3 text-base font-normal text-gray-200 text-pretty">{exp.description}</p>
            <ul class="list-disc ms-5 mb-4 space-y-2">
                {exp.highlights.map((item) => (
                    <li class="text-base font-normal text-gray-200 text-pretty">{item}</li>
                ))}
            </ul>
            <ul class="flex flex-wrap gap-2">
                {exp.stack.map((tech) => {
                    const Icon = STACK_ICONS[tech as keyof typeof STACK_ICONS]
                    return (
                        <li>
                            <span class="flex items-center gap-x-2 rounded-full text-xs bg-white/5 border border-white/10 text-white py-1 px-3">
                                {Icon && <Icon class="size-4" />}
                                {tech}
                            </span>
                        </li>
                    )
                })}
            </ul>
        </li>
    ))}
</ol>
